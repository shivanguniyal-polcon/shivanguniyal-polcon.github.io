---
import '../styles/global.css';
import GlowCursor from '../components/GlowCursor';
import EntryGate from '../components/EntryGate';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Shivang Uniyal, policy engineer. Data science, electioneering strategy, and legislative public policy.',
} = Astro.props;

const navLinks = [
  { href: '/projects/', label: 'projects' },
  { href: '/about/', label: 'about' },
  { href: '/learning/', label: 'learnings' },
  { href: '/contact/', label: 'contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const els = document.querySelectorAll('.reveal');
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        els.forEach((el) => io.observe(el));
      });
      // nudge ResponsiveContainer charts that measured zero width during hydration
      window.addEventListener('load', () => {
        setTimeout(() => window.dispatchEvent(new Event('resize')), 250);
        setTimeout(() => window.dispatchEvent(new Event('resize')), 900);
      });
    </script>
  </head>
  <body>
    <EntryGate client:load />
    <GlowCursor client:load />

    <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="nav-logo" style="text-decoration:none">
          <span class="dot"></span> Shivang Uniyal
        </a>
        <div class="nav-links">
          {navLinks.map((l) => (
            <a href={l.href} class={Astro.url.pathname === l.href ? 'active' : ''}>
              {l.label}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <main style="padding-top:62px">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <div class="mono">
          <span class="accent">●</span> Shivang Uniyal · policy engineer
        </div>
        <div class="footer-links">
          <a href="https://github.com/shivanguniyal-polcon/" target="_blank" rel="noopener">github</a>
          <a href="https://www.linkedin.com/in/shivang-uniyal/" target="_blank" rel="noopener">linkedin</a>
          <a href="mailto:shivang.uni@gmail.com">email</a>
        </div>
      </div>
    </footer>
  </body>
</html>
