---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGrid from '../../components/ProjectGrid';
import Terminal from '../../components/Terminal';
import LiveCounters from '../../components/LiveCounters';
---

<BaseLayout
  title="Projects · Shivang Uniyal"
  description="Interactive policy engineering projects across electoral systems, health policy, defence trade, the climate water nexus, and media analytics."
>
  <section style="padding-top:72px">
    <div class="wrap">
      <div class="kicker">projects // ls -la</div>
      <h1 style="font-size:clamp(34px,4.8vw,52px)">
        The evidence, <span style="color:var(--accent); font-style:italic">filterable.</span>
      </h1>
      <p class="lede" style="margin-top:14px">
        Twelve builds across five policy domains. Filter by domain and the grid re-lays itself.
        Every project page opens with the method stack, and every chart is live.
      </p>

      <div style="display:grid; grid-template-columns: 1fr 1fr; gap:28px; margin-top:38px" id="proj-top">
        <div class="reveal">
          <Terminal client:visible />
        </div>
        <div class="reveal" style="--reveal-delay:0.1s">
          <LiveCounters client:visible />
          <div class="data-note" style="margin-top:26px">
            counters count up when they enter the viewport. the numbers come from the projects
            themselves: 48,780 trade observations, 75,000 articles, 9.19 crore reconstructed admissions.
          </div>
        </div>
      </div>

      <div style="margin-top:48px">
        <ProjectGrid client:visible />
      </div>
    </div>
  </section>

  <style>
    @media (max-width: 900px) {
      #proj-top { grid-template-columns: 1fr !important; }
    }
  </style>
</BaseLayout>
