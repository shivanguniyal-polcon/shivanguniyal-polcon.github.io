---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGrid from '../../components/ProjectGrid';
import CaseStudyChart from '../../components/charts/CaseStudyChart';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;

/* public-facing artifacts for this project: live dashboards, publications,
   code. Falls back to the legacy single link field so nothing is dropped. */
const artifacts = [
  ...(project.links ?? []),
  ...(project.link && project.link.startsWith('http') && !(project.links ?? []).some((l) => l.url === project.link)
    ? [{ kind: 'dashboard' as const, url: project.link }]
    : []),
];
---

<BaseLayout title={`${project.title} · Shivang Uniyal`} description={project.tagline}>
  <section style="padding-top:72px">
    <div class="wrap-tight">
      <a href="/projects/" class="backlink">← cd ../projects</a>

      <div class="kicker">{project.domain.toLowerCase().replaceAll(' ', '_')}</div>
      <h1 style="font-size:clamp(32px,4.6vw,48px)">{project.title}</h1>
      <p class="lede" style="margin-top:16px; font-size:18px">{project.tagline}</p>

      <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:22px">
        {project.methods.map((m) => <span class="chip accent-chip">{m}</span>)}
      </div>

      <div class="mono faint" style="margin-top:18px; font-size:12.5px">
        <span class={`status-dot status-${project.status}`}></span>
        {project.status} · {project.year}
      </div>

      {artifacts.length > 0 && (
        <div class="artifact-row" style="margin-top:14px">
          {artifacts.map((a) => (
            <a
              class={`artifact-link artifact-${a.kind}`}
              href={a.url}
              target="_blank"
              rel="noopener"
            >
              <span class="artifact-kind">{a.kind === 'dashboard' ? 'live dashboard' : a.kind === 'publication' ? 'publication' : 'code'}</span>
              <span class="artifact-label">{a.label ?? (a.kind === 'dashboard' ? 'open dashboard' : a.kind === 'publication' ? 'read the paper' : 'view repository')} ↗</span>
            </a>
          ))}
        </div>
      )}

      {project.heroStat && (
        <div class="card" style="padding:22px 26px; margin-top:28px; display:flex; align-items:baseline; gap:18px; flex-wrap:wrap">
          <span class="mono" style="font-size:clamp(26px,3.4vw,34px); color:var(--accent); font-weight:700">
            {project.heroStat.value}
          </span>
          <span class="dim" style="font-size:14px">{project.heroStat.label}</span>
        </div>
      )}
    </div>
  </section>

  {project.chart && (
    <section style="padding-top:26px">
      <div class="wrap">
        <div class="reveal">
          <CaseStudyChart client:visible chart={project.chart} />
        </div>
      </div>
    </section>
  )}

  <section style="padding-top:36px">
    <div class="wrap-tight prose">
      {project.sections.map((s) => (
        <div class="reveal">
          <h2>{s.heading}</h2>
          <p>{s.body}</p>
        </div>
      ))}
    </div>
  </section>

  {project.inference && (
    <section style="padding-top:10px">
      <div class="wrap-tight">
        <div class="reveal cs-block" style="border-color: var(--accent)">
          <div class="cs-kicker" style="color:var(--accent)">inference</div>
          <p class="cs-inference">{project.inference}</p>
        </div>
      </div>
    </section>
  )}

  {project.implications && (
    <section style="padding-top:10px">
      <div class="wrap-tight">
        <div class="reveal cs-block">
          <div class="cs-kicker">implications</div>
          <ul class="cs-list">
            {project.implications.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      </div>
    </section>
  )}

  {project.recommendations && (
    <section style="padding-top:10px">
      <div class="wrap-tight">
        <div class="reveal cs-block" style="border-color: rgba(56, 189, 248, 0.5)">
          <div class="cs-kicker" style="color:var(--cyan)">policy recommendations</div>
          <ol class="cs-list cs-ordered">
            {project.recommendations.map((r) => <li>{r}</li>)}
          </ol>
        </div>
      </div>
    </section>
  )}

  {project.methodology && (
    <section style="padding-top:10px">
      <div class="wrap-tight">
        <div class="reveal cs-block">
          <div class="cs-kicker">methodology</div>
          <div class="cs-steps">
            {project.methodology.map((m, i) => (
              <div class="cs-step">
                <span class="cs-stepnum mono">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <div class="cs-stepname">{m.step}</div>
                  <div class="cs-stepdetail">{m.detail}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  {project.sources && (
    <section style="padding-top:10px">
      <div class="wrap-tight">
        <div class="reveal cs-block">
          <div class="cs-kicker">data sources</div>
          <table class="cs-table">
            <tbody>
              {project.sources.map((s) => (
                <tr>
                  <td class="cs-src-name">{s.name}</td>
                  <td class="cs-src-role">{s.role}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  {project.dataHighlights && (
    <section style="padding-top:10px">
      <div class="wrap-tight">
        <div class="reveal">
          <div class="cs-kicker">data highlights</div>
          <div class="stat-row" style="margin-top:14px">
            {project.dataHighlights.map((h) => (
              <div class="stat">
                <div class="value" style="font-size:clamp(20px,2.6vw,26px)">{h.value}</div>
                <div class="label">{h.label}</div>
                {h.note && <div class="cs-statnote">{h.note}</div>}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  {project.dataTable && (
    <section style="padding-top:26px">
      <div class="wrap-tight">
        <div class="reveal cs-block">
          <div class="cs-kicker">the data, on the page</div>
          <div class="cs-tabletitle">{project.dataTable.title}</div>
          <div style="overflow-x:auto">
            <table class="cs-table">
              <thead>
                <tr>
                  {project.dataTable.columns.map((c) => <th key={c}>{c}</th>)}
                </tr>
              </thead>
              <tbody>
                {project.dataTable.rows.map((row) => (
                  <tr>
                    {row.map((cell) => <td>{cell}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {project.dataTable.note && <div class="data-note">{project.dataTable.note}</div>}
        </div>
      </div>
    </section>
  )}

  <!-- next projects -->
  <section style="padding-top:40px">
    <div class="wrap">
      <div class="kicker">keep_reading</div>
      <div style="margin-top:10px">
        <ProjectGrid client:visible showFilters={false} limit={3} exclude={[project.slug]} />
      </div>
    </div>
  </section>

  <style>
    .prose p { margin: 0 0 8px; }
    .cs-block {
      border: 1px solid var(--line);
      border-left: 3px solid var(--line-bright);
      border-radius: 10px;
      background: var(--bg-card);
      padding: 22px 26px;
    }
    .cs-kicker {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 12px;
    }
    .cs-inference {
      font-size: 14px;
      line-height: 1.8;
      color: var(--ink);
      margin: 0;
    }
    .cs-list { margin: 0; padding-left: 20px; display: grid; gap: 9px; }
    .cs-list li { color: var(--ink-dim); font-size: 15.5px; line-height: 1.65; }
    .cs-list li::marker { color: var(--accent); }
    .cs-ordered li::marker { color: var(--cyan); font-family: var(--font-mono); font-size: 13px; }
    .cs-steps { display: grid; gap: 14px; }
    .cs-step { display: flex; gap: 14px; align-items: baseline; }
    .cs-stepnum {
      color: var(--accent);
      font-size: 12px;
      border: 1px solid rgba(74, 222, 128, 0.35);
      border-radius: 6px;
      padding: 2px 7px;
      flex-shrink: 0;
    }
    .cs-stepname { font-weight: 600; font-size: 14.5px; color: var(--ink); }
    .cs-stepdetail { color: var(--ink-dim); font-size: 14px; line-height: 1.6; margin-top: 2px; }
    .cs-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .cs-table th {
      text-align: left;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-faint);
      padding: 8px 12px;
      border-bottom: 1px solid var(--line-bright);
    }
    .cs-table td {
      padding: 9px 12px;
      border-bottom: 1px dashed var(--line);
      color: var(--ink-dim);
      vertical-align: top;
    }
    .cs-table tr:last-child td { border-bottom: none; }
    .cs-src-name { color: var(--ink) !important; font-weight: 500; width: 34%; }
    .cs-src-role { font-size: 13.5px; }
    .cs-tabletitle { font-weight: 600; font-size: 15px; margin-bottom: 12px; color: var(--ink); }
    .cs-statnote {
      font-family: var(--font-mono);
      font-size: 10.5px;
      color: var(--ink-faint);
      margin-top: 5px;
      line-height: 1.5;
      max-width: 210px;
    }
    /* day mode: step numbers keyed to the leaf green */
    :global(html.mode-day) .cs-stepnum { border-color: rgba(28, 122, 67, 0.45); }
  </style>
</BaseLayout>
