---
import BaseLayout from '../layouts/BaseLayout.astro';

const phases = [
  {
    era: '2025 to present',
    title: 'Policy Engineering and AI',
    role: 'MPP Candidate · IIT Delhi',
    body: 'Democratic institutions meet artificial intelligence. I build scalable, localized AI agents on open source models so that public sector data stays autonomous, outside closed cloud ecosystems.',
    cert: 'Artificial Intelligence Fundamentals · IBM (Jun 2025)',
  },
  {
    era: '2022 to 2023',
    title: 'Data-Driven Governance',
    role: 'Governance and Electioneering Consultant · Nation with NaMo',
    body: 'Electoral strategy executed on large scale datasets. Translating broad political objectives into ground level operations, and moving from basic analysis to serious data handling.',
    cert: 'Microsoft Excel, Data Analysis Expert · Six Sigma Academy (Jan 2022)',
  },
  {
    era: '2021 to 2022',
    title: 'Legislative Analysis and Economics',
    role: 'LAMP Fellow · PRS Legislative Research',
    body: 'Inside a Member of Parliament\'s office: how laws are constructed and debated. Policy analysis needs economic literacy and programming logic in equal measure.',
    cert: 'Globalization, Economic Growth and Stability · IE Business School (Aug 2020)',
    cert2: 'Programming for Everybody, Python · University of Michigan (Jun 2020)',
  },
  {
    era: '2017 to 2021',
    title: 'Foundational Research and Theory',
    role: 'B.A. (Hons.) Governance and Public Administration · PDEU (Gold Medalist)',
    body: 'Ground level fieldwork in urban sanitation, migration, and rural development, grounded in political theory and statistics.',
    cert: 'Moral Foundations of Politics · Yale University (May 2020)',
    cert2: 'Probability and Statistics Master · Krista King Math (Apr 2020)',
  },
];
---

<BaseLayout title="Learnings · Shivang Uniyal" description="From political theory to data-driven governance to technical policy engineering.">
  <section style="padding-top:80px">
    <div class="wrap-tight">
      <div class="kicker">git log --career</div>
      <h1 style="font-size:clamp(34px,4.8vw,52px)">
        Still <span style="color:var(--accent); font-style:italic">learning.</span>
      </h1>
      <p class="lede" style="margin-top:14px">
        Political theory, then data driven governance, then technical policy engineering.
        Each phase has an anchor: a certification that formalized the toolkit at the time.
      </p>

      <div class="timeline" style="margin-top:52px">
        {phases.map((p, i) => (
          <div class="tl-item reveal" style={`--reveal-delay:${i * 0.08}s`}>
            <div class="era">{p.era}</div>
            <h3>{p.title}</h3>
            <div class="mono" style="font-size:12.5px; color:var(--cyan); margin-bottom:10px">{p.role}</div>
            <p>{p.body}</p>
            <div class="cert">{p.cert}</div>
            {p.cert2 && <div class="cert">{p.cert2}</div>}
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
