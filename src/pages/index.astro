  <style>
    /* ---------- policy engineer? the growing stem ---------- */
    .stem-section {
      padding: 0 0 72px;
      position: relative;
      scroll-margin-top: 76px;
    }
    .stem-track {
      position: relative;
      padding: 84px 24px 0;
      --stem: 0;
      /* --rise: fist-to-section distance, measured by the script; --stem-x:
         the rail the stem and the attach dots share */
      --rise: 240px;
      --stem-x: 50%;
    }
    .pe-vig {
      position: absolute;
      z-index: 0;
      width: clamp(150px, 16vw, 235px);
      height: auto;
      opacity: 0.11;
      pointer-events: none;
      user-select: none;
    }
    /* alternating sides, spread down the whole scroll */
    .vig-people { top: 4%; left: 3%; }
    .vig-bureau { top: 17%; right: 4%; width: clamp(160px, 17vw, 250px); }
    .vig-courtroom { top: 30%; left: 3%; }
    .vig-kids { top: 44%; right: 4%; width: clamp(140px, 14vw, 205px); }
    .vig-farmer { top: 58%; left: 3%; }
    .vig-thinker { top: 71%; right: 4%; }
    .vig-economy { top: 84%; left: 3%; }
    .stem-svg {
      position: absolute;
      /* the svg rises up into the garden (--rise, measured to the gardener's
         fist) so the sprout begins at the hand; viewBox is kept 1:1 with the
         CSS box, so stroke widths stay true at every breakpoint */
      top: calc(-1 * var(--rise));
      height: calc(100% + var(--rise));
      left: var(--stem-x);
      width: 760px;
      transform: translateX(-50%);
      z-index: 2;
      overflow: visible;
      pointer-events: none;
      /* grow from the top: clip away (1 - stem) of the height from below */
      clip-path: inset(0 0 calc((1 - var(--stem)) * 100%) 0);
    }
    .stem-core,
    .stem-glow { fill: none; }
    .stem-core { stroke: url(#stem-grad); stroke-width: 2; }
    .stem-glow { stroke: #4ade80; stroke-width: 9; opacity: 0.08; }

    /* the heading lives in the right column: the stem sweeps in from the
       gardener's fist on the left, so no word ever sits under the line */
    .stem-head {
      position: relative;
      z-index: 2;
      max-width: min(560px, calc(50% - 120px));
      margin: 0 0 56px auto;
      text-align: left;
    }
    .stem-head .lede { margin: 0; }

    .pe-node {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: 1fr 96px 1fr;
      align-items: center;
      min-height: 330px;
    }
    .pe-stalk {
      grid-column: 2;
      position: relative;
      align-self: stretch;
    }
    /* connector: grows from the stem out to the box as the node reveals */
    .pe-node.left .pe-stalk::before,
    .pe-node.right .pe-stalk::before {
      content: '';
      position: absolute;
      top: 50%;
      height: 1px;
      background: linear-gradient(90deg, rgba(74, 222, 128, 0.05), #2d3a47);
      transform: scaleX(0);
      transition: transform 0.5s ease 0.1s;
    }
    /* connectors and dots are placed by the script via --dot-x, sampled
       from the real path, so they land on the stem wherever it wanders */
    .pe-node.left .pe-stalk::before { left: 0; right: calc(50% - var(--dot-x, 0px)); transform-origin: right center; }
    .pe-node.right .pe-stalk::before { left: calc(50% + var(--dot-x, 0px)); right: 0; transform-origin: left center; }
    .pe-node.on .pe-stalk::before { transform: scaleX(1); }
    /* the attach dot sits exactly on the stem line */
    .pe-stalk::after {
      content: '';
      position: absolute;
      top: 50%;
      left: calc(50% + var(--dot-x, 0px));
      width: 9px;
      height: 9px;
      margin: -6px 0 0 -6px;
      border-radius: 50%;
      background: var(--bg);
      border: 1.5px solid var(--accent);
      box-shadow: 0 0 12px rgba(74, 222, 128, 0.35);
      transform: scale(0);
      transition: transform 0.4s ease 0.2s;
    }
    .pe-node.on .pe-stalk::after { transform: scale(1); }

    .pe-leaf {
      position: absolute;
      width: 34px;
      height: 18px;
      opacity: 0;
      transition: opacity 0.5s ease 0.35s, transform 0.5s ease 0.35s;
    }
    .pe-leaf path { fill: rgba(74, 222, 128, 0.35); stroke: rgba(74, 222, 128, 0.75); stroke-width: 1; }
    /* leaves sprout from the stem into the empty half, base overlapping the line */
    .pe-node.left .pe-leaf { left: calc(50% + var(--dot-x, 0px) - 3px); transform: scale(0.4); }
    .pe-node.left.on .pe-leaf { opacity: 1; transform: scale(1); }
    .pe-node.right .pe-leaf { left: calc(50% + var(--dot-x, 0px) - 31px); transform: scaleX(-1) scale(0.4); }
    .pe-node.right.on .pe-leaf { opacity: 1; transform: scaleX(-1) scale(1); }
    .leaf-up { top: calc(50% - 40px); }
    .leaf-down { top: calc(50% + 22px); }

    .pe-chunk {
      width: min(520px, 100%);
      background: rgba(16, 21, 27, 0.42);
      border: 1px solid rgba(45, 58, 71, 0.55);
      border-radius: var(--radius);
      padding: 20px 22px 18px;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.55s ease, transform 0.55s ease;
    }
    .pe-node.on .pe-chunk { opacity: 1; transform: translateY(0); }
    .pe-node.left .pe-chunk {
      grid-column: 1;
      justify-self: end;
      box-shadow: inset -2px 0 0 rgba(74, 222, 128, 0.4), 0 18px 44px rgba(0, 0, 0, 0.28);
    }
    .pe-node.right .pe-chunk {
      grid-column: 3;
      justify-self: start;
      box-shadow: inset 2px 0 0 rgba(74, 222, 128, 0.4), 0 18px 44px rgba(0, 0, 0, 0.28);
    }
    .pe-chunk-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
    .pe-chunk h3 { font-size: 14px; letter-spacing: 0.02em; color: var(--ink); }
    .pe-idx { font-size: 11px; letter-spacing: 0.14em; color: var(--ink-faint); }
    .pe-chunk p { margin: 10px 0 0; font-size: 13.5px; line-height: 1.75; color: var(--ink-dim); }
    /* claims in the boxes deep-link to the builds that prove them */
    .pe-link {
      color: var(--accent);
      border-bottom: 1px dashed rgba(74, 222, 128, 0.5);
      text-decoration: none;
      transition: border-color 0.2s ease, color 0.2s ease;
    }
    .pe-link:hover { border-bottom-style: solid; color: #a7f3d0; }
    .pe-rows { margin: 12px 0 0; display: grid; gap: 9px; }
    .pe-row {
      display: grid;
      grid-template-columns: 108px 1fr;
      gap: 12px;
      align-items: baseline;
      font-size: 12.5px;
      line-height: 1.6;
      color: var(--ink-dim);
    }
    .pe-key { color: var(--accent); font-size: 12px; }
    .pe-chunk.finale { border-color: rgba(74, 222, 128, 0.38); }
    .pe-punch {
      margin: 14px 0 2px;
      padding: 13px 16px;
      border-left: 2px solid var(--accent);
      background: rgba(74, 222, 128, 0.07);
      border-radius: 0 8px 8px 0;
      color: var(--ink);
      font-size: 13.5px;
      line-height: 1.7;
    }

    .stem-tail { height: 150px; }
    .stem-bloom {
      position: absolute;
      bottom: -26px;
      left: calc(50% + var(--tail-x, 0px));
      width: 84px;
      height: 84px;
      z-index: 1;
      opacity: 0;
      /* translateX centers the bloom on the stem x at every breakpoint,
         so it rides the left rail on mobile too */
      transform: translateX(-50%) scale(0.3) rotate(-30deg);
      transition: transform 0.8s cubic-bezier(0.2, 0.9, 0.3, 1.25), opacity 0.5s ease;
      pointer-events: none;
    }
    .stem-bloom.open { opacity: 1; transform: translateX(-50%) scale(1) rotate(0deg); }
    .stem-bloom.open svg { animation: bloomPulse 4.5s ease-in-out infinite; }
    @keyframes bloomPulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.82; } }

    @media (prefers-reduced-motion: reduce) {
      .pe-chunk,
      .pe-stalk::before,
      .pe-stalk::after,
      .pe-leaf,
      .stem-bloom { transition: none; }
      .stem-bloom.open svg { animation: none; }
    }

    @media (max-width: 860px) {
      .stem-track { padding: 64px 14px 0; --stem-x: 36px; }
      .stem-head { margin-bottom: 40px; padding-left: 72px; max-width: none; }
      .pe-vig { width: clamp(110px, 30vw, 165px); opacity: 0.085; }
      .pe-node { grid-template-columns: 44px 1fr; min-height: 0; padding: 30px 0; }
      .pe-stalk { grid-column: 1; }
      .pe-node.left .pe-chunk,
      .pe-node.right .pe-chunk { grid-column: 2; justify-self: stretch; width: 100%; }
      .pe-node.left .pe-stalk::before { left: calc(50% + var(--dot-x, 0px)); right: 0; transform-origin: left center; }
      .pe-node.left .pe-chunk { box-shadow: inset 2px 0 0 rgba(74, 222, 128, 0.4), 0 18px 44px rgba(0, 0, 0, 0.28); }
      .pe-leaf { display: none; }
      .pe-row { grid-template-columns: 96px 1fr; }
      .stem-bloom { left: calc(36px + var(--tail-x, 0px)); width: 64px; height: 64px; }
    }
  </style>

  <style>
    /* One continuous scene: the GardenScene stage fills the whole landing
       column and the hero copy floats over its sky. Nothing frames it, so
       the page background (#0a0e12) and the painted sky read as one canvas. */
    .landing {
      height: calc(100vh - 62px);
      min-height: 640px;
      position: relative;
    }
    .landing-scene {
      position: absolute;
      inset: 0;
    }
    .landing-scene > astro-island,
    .landing-scene .scene-stage { height: 100%; }
    .landing-hero {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      /* above the scene's bloom scrim (z 7) so the header stays crisp when
         the flower opens; below tooltips (z 50) */
      z-index: 8;
      text-align: center;
      padding-top: 34px;
      pointer-events: none;
      /* parallax: the script writes --hx/--hy (mouse drift, px) and
         --sy (scroll drift, px); translate + the faintest counter-tilt make
         the header float a little behind the sky it sits on */
      transform: translate3d(var(--hx, 0px), calc(var(--hy, 0px) + var(--sy, 0px)), 0);
      opacity: calc(1 - var(--sfade, 0));
      will-change: transform, opacity;
    }
    .landing-hero .kicker,
    .landing-hero h1,
    .landing-hero .lede {
      transform: translate3d(calc(var(--hx2, 0px)), 0, 0);
    }
    @media (max-width: 720px) {
      .landing { min-height: 560px; }
      .landing-hero { padding-top: 22px; }
    }

    /* ---------- day mode: ink and leaf on aged paper ----------
       The switch lives on the garden's moon; these rules recolor the
       explainer so it reads on the beige page. :global wraps the html
       part because scoped selectors never match <html>. */
    :global(html.mode-day) .stem-stop-a { stop-color: #1c7a43; }
    :global(html.mode-day) .stem-stop-b { stop-color: #1c7a43; }
    :global(html.mode-day) .stem-stop-c { stop-color: #2f9457; }
    :global(html.mode-day) .stem-glow { stroke: #1c7a43; opacity: 0.1; }
    :global(html.mode-day) .pe-vig { opacity: 0.15; }
    :global(html.mode-day) .pe-stalk::after { box-shadow: 0 0 12px rgba(28, 122, 67, 0.4); }
    :global(html.mode-day) .pe-node.left .pe-stalk::before,
    :global(html.mode-day) .pe-node.right .pe-stalk::before {
      background: linear-gradient(90deg, rgba(28, 122, 67, 0.06), #b3a685);
    }
    :global(html.mode-day) .pe-leaf path {
