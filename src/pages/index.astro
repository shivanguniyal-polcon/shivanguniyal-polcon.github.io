            <path d="M48 47 C 60 38, 64 22, 48 8 C 32 22, 36 38, 48 47 Z" fill="rgba(74, 222, 128, 0.16)" transform="rotate(216 48 48)" />
            <path d="M48 47 C 60 38, 64 22, 48 8 C 32 22, 36 38, 48 47 Z" fill="rgba(74, 222, 128, 0.16)" transform="rotate(288 48 48)" />
