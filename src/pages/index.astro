      border-color: rgba(133, 120, 90, 0.55);
    }
    :global(html.mode-day) .pe-node.left .pe-chunk {
      box-shadow: inset -2px 0 0 rgba(28, 122, 67, 0.45), 0 18px 44px rgba(70, 58, 32, 0.18);
    }
    :global(html.mode-day) .pe-node.right .pe-chunk {
      box-shadow: inset 2px 0 0 rgba(28, 122, 67, 0.45), 0 18px 44px rgba(70, 58, 32, 0.18);
    }
    :global(html.mode-day) .pe-link { border-bottom-color: rgba(28, 122, 67, 0.5); }
    :global(html.mode-day) .pe-link:hover { color: #14532d; }
    :global(html.mode-day) .pe-chunk.finale { border-color: rgba(28, 122, 67, 0.45); }
    :global(html.mode-day) .pe-punch { background: rgba(28, 122, 67, 0.08); }
    :global(html.mode-day) .stem-bloom circle[fill="#0a0e12"] { fill: #ece5d3; }
    :global(html.mode-day) .stem-bloom stop { stop-color: #1c7a43; }
    :global(html.mode-day) .stem-bloom g[stroke="#4ade80"] { stroke: #1c7a43; }
    :global(html.mode-day) .stem-bloom path[fill^="rgba(74"] { fill: rgba(28, 122, 67, 0.14); }
    :global(html.mode-day) .stem-bloom circle[fill="#4ade80"] { fill: #1c7a43; }
  </style>

  <script>
    /* dusk + parallax: as the visitor scrolls from the garden into the
       projects section the sky darkens (--skydim) and the hero drifts up and
       fades; on fine pointers the hero also drifts a few px against the
       mouse, so the header feels laid onto the scene, not pasted over it. */
    const stage = () => document.querySelector('.scene-stage');
    const hero = () => document.querySelector('.landing-hero');
    const fine = window.matchMedia('(pointer: fine)').matches;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));

    let mx = 0, my = 0; // mouse target in -1..1
    let cx = 0, cy = 0; // eased mouse
    let raf = 0;

    const apply = () => {
      raf = 0;
      const st = stage();
      const h = hero();
      if (!st || !h) return;

      // scroll: 0 at top, 1 at the bottom of the page (footer in view), so the
      // garden is at full dusk exactly when the projects/footer region takes over
      const range = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      const sy = clamp(window.scrollY / range, 0, 1);
      st.style.setProperty('--skydim', sy.toFixed(3));
      h.style.setProperty('--sy', `${(-34 * sy).toFixed(1)}px`);
      h.style.setProperty('--sfade', sy.toFixed(3));

      // mouse: hero leans a few px away from the cursor, inner lines less
      cx += (mx - cx) * 0.08;
      cy += (my - cy) * 0.08;
      h.style.setProperty('--hx', `${(cx * 7).toFixed(2)}px`);
      h.style.setProperty('--hy', `${(cy * 4).toFixed(2)}px`);
      h.style.setProperty('--hx2', `${(cx * 3.5).toFixed(2)}px`);
    };

    const schedule = () => { if (!raf) raf = requestAnimationFrame(apply); };

    const onScroll = () => { if (!reduced) schedule(); };
    const onMouse = (e: MouseEvent) => {
      if (reduced || !fine) return;
      mx = (e.clientX / window.innerWidth) * 2 - 1;
      my = (e.clientY / window.innerHeight) * 2 - 1;
      schedule();
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    if (fine) window.addEventListener('mousemove', onMouse, { passive: true });
    apply();
  </script>

  <script>
    /* the growing stem: it sprouts from the gardener's fist (the live
       .hand-anchor the garden renders once hydrated), leans back to the rail
       as it grows, then runs straight past the attach dots. --stem (0..1) is
       the share of the path drawn, measured from the fist. The growth tip
       rides at 72% of the viewport height; a node reveals when the tip
       passes its dot. Near the very bottom of the page the growth finishes
       so the last chunk and the bloom always arrive. */
    (() => {
      const sec = document.getElementById('policy-engineer');
      if (!sec) return;
      const track = sec.querySelector<HTMLElement>('.stem-track');
      const nodes = Array.from(sec.querySelectorAll<HTMLElement>('.pe-node'));
      const bloomEl = sec.querySelector<HTMLElement>('.stem-bloom');
      const svgEl = sec.querySelector<SVGSVGElement>('.stem-svg');
      const corePath = sec.querySelector<SVGPathElement>('.stem-core');
      const glowPath = sec.querySelector<SVGPathElement>('.stem-glow');
      if (!track || !svgEl || !corePath || !glowPath) return;
      const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
      const SW = 760;   /* svg width in px == viewBox units, so 1:1 */
      const CX = SW / 2;/* the rail (stalk line) in svg x */
      let trackTop = 0;
      let trackH = 1;
      let rise = 240;   /* fist down to the section top */
      let handDx = -96; /* fist x relative to the rail */
      let handFound = false;
      let pathLen = 1;

      /* seeded PRNG: the meander is organic but identical on every rebuild,
         so resizes never make the plant visibly jump. Seed 10 was picked by
         sweeping 500 seeds for rhythm: 4 rail crossings, max 95px sway, no
         stub segments near the bloom. The generator is re-created on every
         buildPath call, so repeated re-measures replay the same walk. */
      const mkRand = (seed: number) => () => {
        seed = (seed + 0x6d2b79f5) | 0;
        let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };

      /* x on the stem at a given y. The path is monotonic in y (every
         control point keeps that order), so a binary search over arc
         length finds it in ~22 steps. */
      const xAtY = (y: number) => {
        let lo = 0;
        let hi = pathLen;
        for (let i = 0; i < 22; i++) {
          const mid = (lo + hi) / 2;
          if (corePath.getPointAtLength(mid).y < y) lo = mid;
          else hi = mid;
        }
        return corePath.getPointAtLength((lo + hi) / 2).x;
      };

      /* Organic stems are drawn the way illustrators draw them (the
         generative-art trick): drop waypoints with a mean-reverting random
         walk so the plant wanders but stays in its lane, then join each
         pair with a cubic whose handles alternate the approach side. That
         alternating flip is what makes the line read as bends with dents
         between them, not one uniform sine. */
      const buildPath = () => {
        const rand = mkRand(10);
        const total = Math.round(rise + trackH);
        svgEl.setAttribute('viewBox', `0 0 ${SW} ${total}`);
        track.style.setProperty('--rise', `${Math.round(rise)}px`);
        const hx = CX + handDx;
        const pts: Array<{ x: number; y: number }> = [{ x: hx, y: 0 }];
        /* the walk: waypoints every 300-560px, mean-reverting steps with
           a 95px kick, kept inside a 140px lane. The last waypoint is
           forced to the bottom so the bloom never lands on a stub bend. */
        let y = 0;
        let x = hx;
        for (;;) {
          const ny = y + 300 + rand() * 260;
          y = ny >= total - 620 ? total : Math.min(ny, total - 620);
          const step = (rand() * 2 - 1) * 95 + (CX - x) * 0.3;
          x = clamp(x + step, CX - 140, CX + 140);
          pts.push({ x: Math.round(x), y: Math.round(y) });
          if (y >= total) break;
        }
        let d = `M ${pts[0].x} 0`;
        for (let i = 1; i < pts.length; i++) {
          const p0 = pts[i - 1];
          const p1 = pts[i];
          const h = Math.max(60, p1.y - p0.y);
          const side = i % 2 ? 1 : -1;
          const e = Math.min(90, 10 + rand() * h * 0.16) * side;
          const f = h * (0.32 + rand() * 0.12);
          d += ` C ${(p0.x + e).toFixed(1)} ${(p0.y + f).toFixed(0)},` +
            ` ${(p1.x - e).toFixed(1)} ${(p1.y - f).toFixed(0)}, ${p1.x} ${p1.y}`;
        }
        corePath.setAttribute('d', d);
        glowPath.setAttribute('d', d);
        pathLen = corePath.getTotalLength();
      };

      const measure = () => {
        const r = track.getBoundingClientRect();
        trackTop = r.top + window.scrollY;
        trackH = Math.max(1, r.height);
        /* the fist: the live hand-anchor inside the garden scene; the rail:
           the first stalk column the dots hang from. Both measured in the
           same frame, so the deltas are scroll-independent. */
        const hand = document.querySelector('.hand-anchor');
        const stalk = sec.querySelector<HTMLElement>('.pe-stalk');
        if (hand && stalk) {
          const hr = hand.getBoundingClientRect();
          const sr = stalk.getBoundingClientRect();
          rise = Math.max(80, Math.round(r.top - hr.top));
          handDx = Math.round(hr.left + hr.width / 2 - (sr.left + sr.width / 2));
          handFound = true;
        }
        buildPath();
        /* the dots, connectors, and the bloom sample the real path so they
           sit on the line however far the plant wandered */
        for (const n of nodes) {
          const ySvg = rise + n.offsetTop + n.offsetHeight * 0.5;
          n.style.setProperty('--dot-x', `${(xAtY(ySvg) - CX).toFixed(1)}px`);
        }
        track.style.setProperty('--tail-x', `${(xAtY(rise + trackH - 6) - CX).toFixed(1)}px`);
      };

      const apply = () => {
        /* until the garden hydrates and hands us the anchor, re-measure on
           every scroll: it is four rect reads, and it self-stops once found */
        if (!handFound) measure();
        const stemTop = trackTop - rise;
        const total = rise + trackH;
        const tip = window.scrollY + window.innerHeight * 0.72;
        let p = (tip - stemTop) / total;
        if (document.documentElement.scrollHeight - window.innerHeight - window.scrollY < 200) p = 1;
        p = clamp(p, 0, 1);
        track.style.setProperty('--stem', p.toFixed(4));
        /* garden captions (figure tag, hints) recede while the sprout is
           still inside the scene: gone before the stem crosses their line */
        const stage = document.querySelector('.scene-stage');
        if (stage) stage.style.setProperty('--gfade', clamp(p * 22, 0, 1).toFixed(3));
        const tipY = stemTop + p * total;
        for (const n of nodes) {
          n.classList.toggle('on', tipY >= trackTop + n.offsetTop + n.offsetHeight * 0.5);
        }
        if (bloomEl) bloomEl.classList.toggle('open', p >= 0.985);
      };

      /* scroll runs apply() directly: the work is a few style writes and 9
         class toggles, and scroll events arrive at most once per frame, so
         an rAF gate buys nothing and deadlocks in background tabs, where
         rAF callbacks never fire. */
      window.addEventListener('scroll', apply, { passive: true });
      window.addEventListener('resize', () => { measure(); apply(); });
      window.addEventListener('load', () => { measure(); apply(); });
      measure();
      apply();
      /* layout settles late (fonts, the hydrating garden that places the
         hand-anchor): re-measure, then once more for safety */
      setTimeout(() => { measure(); apply(); }, 450);
      setTimeout(() => { measure(); apply(); }, 1600);
    })();
  </script>
</BaseLayout>
