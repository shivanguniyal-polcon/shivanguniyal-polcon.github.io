          <circle cx="48" cy="48" r="40" fill="url(#bloom-glow)" />
          <g stroke="#4ade80" stroke-width="1.4">
            <path d="M48 47 C 60 38, 64 22, 48 8 C 32 22, 36 38, 48 47 Z" fill="rgba(74, 222, 128, 0.16)" />
            <path d="M48 47 C 60 38, 64 22, 48 8 C 32 22, 36 38, 48 47 Z" fill="rgba(74, 222, 128, 0.16)" transform="rotate(72 48 48)" />
