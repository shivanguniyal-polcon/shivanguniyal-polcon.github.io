---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact · Shivang Uniyal"
  description="Contact Shivang Uniyal for policy engineering, research collaboration, and consulting work."
>
  <section style="padding-top:88px">
    <div class="wrap-tight">
      <div class="kicker">contact // ping</div>
      <h1 style="font-size:clamp(32px,4.4vw,46px)">Get in touch.</h1>
      <p class="lede" style="margin-top:14px">
        The fastest route is email. I read everything and I reply within two working days.
        For research collaboration, include the question you are trying to answer.
      </p>

      <div style="display:flex; flex-direction:column; gap:14px; margin-top:40px">
        <a class="card contact-card" href="mailto:shivang.uni@gmail.com" style="text-decoration:none">
          <div class="cc-icon">@</div>
          <div>
            <h3>Email</h3>
            <div class="cc-sub">shivang.uni@gmail.com</div>
          </div>
          <div class="cc-action">open mail app →</div>
        </a>

        <a class="card contact-card" href="https://www.linkedin.com/in/shivang-uniyal/" target="_blank" rel="noopener" style="text-decoration:none">
          <div class="cc-icon" style="color:var(--cyan)">in</div>
          <div>
            <h3>LinkedIn</h3>
            <div class="cc-sub">professional profile and updates</div>
          </div>
          <div class="cc-action">open profile ↗</div>
        </a>

        <a class="card contact-card" href="https://github.com/shivanguniyal-polcon/" target="_blank" rel="noopener" style="text-decoration:none">
          <div class="cc-icon" style="color:var(--violet)">&lt;/&gt;</div>
          <div>
            <h3>GitHub</h3>
            <div class="cc-sub">code, pipelines, and analysis repos</div>
          </div>
          <div class="cc-action">open profile ↗</div>
        </a>

        <a class="card contact-card" href="https://www.instagram.com/shiv._.vang" target="_blank" rel="noopener" style="text-decoration:none">
          <div class="cc-icon" style="color:#f472b6">◎</div>
          <div>
            <h3>Instagram</h3>
            <div class="cc-sub">the human, outside the terminal</div>
          </div>
          <div class="cc-action">open profile ↗</div>
        </a>
      </div>

      <div class="data-note" style="margin-top:36px">
        status: open to policy research roles, consulting engagements, and collaboration on
        computational social science. Based in India, working everywhere.
      </div>
    </div>
  </section>
</BaseLayout>
